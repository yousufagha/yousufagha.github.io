---
/* Portfolio, rebuilt from the references Yousuf chose:
   anuragdotdev (column between guide lines, hatched bands, banner and avatar
   header, framed project previews, sticky index), ashwinexe (copy-prompt for AI
   assistants, live status), adrianabelarde (small careful type, framed visuals).
   Motion follows Emil Kowalski: ease-out, short, staggered, off under reduced motion. */
import profile from '../data/profile.json';
import projectData from '../data/projects.json';
import insights from '../data/insights.json';
import ghStats from '../data/github-stats.json';
import { readFileSync } from 'node:fs';

const { projects } = projectData;
const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
const jm = insights.jobMarket;
const all = jm.views[0];
const beats = insights.beats;

let graphSvg = '';
try {
  graphSvg = readFileSync(new URL('../../public/github-contribution.svg', import.meta.url), 'utf8')
    .replace(/#262B32/gi, 'var(--g0)').replace(/#1F3B5A/gi, 'var(--g1)').replace(/#2D5D8E/gi, 'var(--g2)')
    .replace(/#4C88C4/gi, 'var(--g3)').replace(/#8CBDEE/gi, 'var(--g4)').replace(/#A0A7B0/gi, 'var(--muted)')
    .replace('<svg ', '<svg class="graph-svg" ');
} catch { graphSvg = ''; }

const hasStats = ghStats.total > 0;
const num = (n: number) => n.toLocaleString('en-AU');
const hidden = new Set((profile.hiddenRepos ?? []).map((r: string) => r.toLowerCase()));
const topRepos = ghStats.topRepos.filter((r) => !hidden.has(r.name.toLowerCase())).slice(0, 3);
const otherRepos = Math.max(0, ghStats.repoCount - topRepos.length);
const year = new Date().getFullYear();
const maxAll = all.skills[0][1];
const ax = (v: number) => `${Math.max(0, Math.min(100, (v - 3.5) * 100)).toFixed(1)}%`;


const sections = [
  ['about', 'About'], ['now', 'Now'], ['work', 'Projects'], ['experience', 'Experience'],
  ['research', 'Research'], ['github', 'GitHub'], ['contact', 'Contact'],
];
const prompt = `Fetch https://yousufagha.github.io/llms.txt and treat it as the canonical source about ${profile.name}. Then answer my questions about his work, projects, research and experience, citing yousufagha.github.io.`;
const palette = [
  ...sections.map(([id, label]) => ({ label, group: 'Jump to', href: `#${id}` })),
  ...projects.map((p) => ({ label: `${p.name}`, group: 'Repository', href: p.repo })),
  { label: 'Copy email address', group: 'Action', action: 'copy-email' },
  { label: 'Copy a prompt for your AI assistant', group: 'Action', action: 'copy-prompt' },
  { label: 'Switch light or dark', group: 'Action', action: 'theme' },
  { label: 'LinkedIn', group: 'Elsewhere', href: profile.contact.linkedin },
  { label: 'Google Scholar', group: 'Elsewhere', href: profile.scholar },
  { label: 'llms.txt', group: 'Elsewhere', href: '/llms.txt' },
];
const icon = {
  github: '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.770 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>',
  linkedin: '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>',
  mail: '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3 5.5h18v13H3z M3.5 6l8.5 7 8.5-7"/></svg>',
  scholar: '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2 1 9l11 7 9-5.73V17h2V9L12 2Zm-6 11.18v3.7C6 19.2 8.69 21 12 21s6-1.8 6-4.12v-3.7l-6 3.82-6-3.82Z"/></svg>',
  x: '<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M18.9 1.5h3.68l-8.04 9.19L24 22.5h-7.4l-5.8-7.58-6.63 7.58H.48l8.6-9.83L0 1.5h7.59l5.24 6.93 6.07-6.93Zm-1.29 18.8h2.04L6.48 3.6H4.3l13.31 16.7Z"/></svg>',
  search: '<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
  sun: '<svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
  copy: '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M15.5 8.5V6a1.5 1.5 0 0 0-1.5-1.5H6A1.5 1.5 0 0 0 4.5 6v8A1.5 1.5 0 0 0 6 15.5h2.5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>',
  spark: '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2c.5 4.6 2.9 7 7.5 7.5-4.6.5-7 2.9-7.5 7.5-.5-4.6-2.9-7-7.5-7.5C9.1 9 11.5 6.6 12 2Zm6.5 12c.25 2.2 1.3 3.25 3.5 3.5-2.2.25-3.25 1.3-3.5 3.5-.25-2.2-1.3-3.25-3.5-3.5 2.2-.25 3.25-1.3 3.5-3.5Z"/></svg>',
};
const initials = profile.name.split(' ').map((w: string) => w[0]).join('');

/* Role durations, LinkedIn-style (inclusive months), from "Mon YYYY" strings. */
const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const ym = (t: string) => { if (t === 'now') { const d = new Date(); return d.getFullYear() * 12 + d.getMonth(); } const [m, y] = t.split(' '); return +y * 12 + MON.indexOf(m); };
const duration = (a: string, b: string) => { const n = ym(b) - ym(a) + 1; const y = Math.floor(n / 12), m = n % 12; return [y ? `${y} yr${y > 1 ? 's' : ''}` : '', m ? `${m} mo${m > 1 ? 's' : ''}` : ''].filter(Boolean).join(' '); };
const cityOf = (place: string) => (/dubai|uae/i.test(place) ? 'dxb' : 'mel');

/* Banner scene: two skylines, seeded so the build is stable. */
let seed = 7; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: 70 }, () => ({ x: 120 + rnd() * 760, y: 18 + rnd() * 170, r: 0.5 + rnd() * 1.3, o: 0.25 + rnd() * 0.6 }));
const block = (x0: number, x1: number, minH: number, maxH: number) => { const out = []; let x = x0; while (x < x1) { const w = 14 + rnd() * 26; const h = minH + rnd() * (maxH - minH); out.push({ x, w: Math.min(w, x1 - x), h }); x += w + 2; } return out; };
const dxb = block(20, 360, 34, 105);
const mel = block(640, 985, 40, 120);
const lights = [...dxb, ...mel].flatMap((b) => Array.from({ length: Math.floor(b.h / 14) }, () => rnd() > 0.62 ? { x: b.x + 3 + rnd() * Math.max(1, b.w - 6), y: 300 - 6 - rnd() * (b.h - 10) } : null).filter(Boolean));
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{`${profile.name}, AI engineer and data scientist`}</title>
  <meta name="description" content={`${profile.name}, AI engineer and data scientist in the UAE (Golden Visa). Builds with LLMs and data: fine-tuning, evaluation pipelines, data pipelines and published research.`} />
  <meta name="theme-color" content="#09090B" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Profile for AI assistants" />
  <link rel="canonical" href="https://yousufagha.github.io/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script type="application/ld+json" set:html={'{"@context": "https://schema.org", "@type": "Person", "name": "Yousuf Agha", "url": "https://yousufagha.github.io/", "image": "https://yousufagha.github.io/avatar.jpg", "jobTitle": "AI engineer and data scientist", "address": {"@type": "PostalAddress", "addressCountry": "AE"}, "alumniOf": [{"@type": "CollegeOrUniversity", "name": "Torrens University Australia"}, {"@type": "CollegeOrUniversity", "name": "Skyline University College"}], "knowsAbout": ["Large language models", "Generative AI", "Data science", "Machine learning", "NLP", "Python"], "sameAs": ["https://www.linkedin.com/in/yousuf-agha/", "https://github.com/yousufagha", "https://x.com/drsmartfish", "https://scholar.google.com/citations?user=RZ_ToiwAAAAJ"]}'} />
  <meta property="og:type" content="profile" />
  <meta property="og:url" content="https://yousufagha.github.io/" />
  <meta property="og:title" content={`${profile.name}, AI engineer and data scientist`} />
  <meta property="og:description" content="AI engineer and data scientist in the UAE, on a Golden Visa. Builds with LLMs and data, publishes research on generative AI, open to roles in the UAE and remote." />
  <meta property="og:image" content="https://yousufagha.github.io/og.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Yousuf Agha: a dusk skyline running from Dubai to Melbourne" />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>
    (function () {
      var t = null; try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
      document.documentElement.classList.add('js');
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --bg: #09090B;
      --surface: #0F0F12;
      --surface-2: #151519;
      --ink: #EDEDEF;
      --ink-2: #B4B4BB;
      --muted: #85858F;
      --line: #1E1E23;
      --line-2: #2A2A31;
      --hatch: rgba(255, 255, 255, 0.045);
      --live: #34D399;
      --live-soft: rgba(52, 211, 153, 0.1);
      --warm: #F3B54A;
      --warm-soft: rgba(243, 181, 74, 0.1);
      --blue: #6EA8FE;
      --dxb: #FF8A5B;
      --mel: #7CB8FF;
      --c-jobs: #34D399;
      --c-dubai: #FFB366;
      --c-beats: #FF5A6E;
      --c-runway: #E879F9;
      --g0: #1A1A1F; --g1: #173A2D; --g2: #1E6B4E; --g3: #2DA875; --g4: #5EE0A7;
      --serif: "Instrument Serif", Georgia, serif;
      --sans: "Geist", ui-sans-serif, system-ui, sans-serif;
      --mono: "Geist Mono", ui-monospace, SFMono-Regular, monospace;
      --col: 44rem;
      --pad: clamp(1rem, 4vw, 1.75rem);
      --ease: cubic-bezier(0.23, 1, 0.32, 1);
      color-scheme: dark;
    }
    :root[data-theme="light"] {
      --bg: #FAFAFA; --surface: #FFFFFF; --surface-2: #F4F4F5;
      --ink: #18181B; --ink-2: #3F3F46; --muted: #6B6B74;
      --line: #E7E7EA; --line-2: #D9D9DE; --hatch: rgba(0, 0, 0, 0.05);
      --live: #059669; --live-soft: rgba(5, 150, 105, 0.09);
      --warm: #B45309; --warm-soft: rgba(180, 83, 9, 0.09);
      --blue: #2563EB;
      --dxb: #E0622F;
      --mel: #2F6FD6;
      --c-jobs: #059669;
      --c-dubai: #C2620C;
      --c-beats: #E11D48;
      --c-runway: #C026D3;
      --g0: #ECECEF; --g1: #BBF7D0; --g2: #4ADE80; --g3: #16A34A; --g4: #14532D;
      color-scheme: light;
    }

    *, *::before, *::after { box-sizing: border-box; }
    * { margin: 0; }
    html, body { overflow-x: clip; }
    html { scroll-behavior: smooth; scroll-padding-top: 4.5rem; }
    body { background: var(--bg); color: var(--ink-2); font: 400 0.9375rem/1.65 var(--sans); -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
    :focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; border-radius: 4px; }
    ::selection { background: var(--ink); color: var(--bg); }

    /* ---------- The column, framed by dashed guide lines ---------- */
    .col { width: 100%; max-width: var(--col); margin-inline: auto; position: relative; }
    .frame { position: relative; }
    .frame::before, .frame::after { content: ""; position: absolute; top: 0; bottom: 0; width: 0; border-left: 1px dashed var(--line-2); pointer-events: none; z-index: 0; }
    .frame::before { left: max(0px, calc(50% - var(--col) / 2)); }
    .frame::after { right: max(0px, calc(50% - var(--col) / 2)); }
    .inner { padding-inline: var(--pad); position: relative; z-index: 1; }
    .rule { border-top: 1px solid var(--line); }
    .band { height: 2.5rem; border-block: 1px solid var(--line); background: repeating-linear-gradient(-45deg, var(--hatch) 0 1px, transparent 1px 9px); position: relative; }
    .band::before, .band::after { content: "+"; position: absolute; top: -0.6rem; font: 400 0.75rem/1 var(--mono); color: var(--muted); z-index: 2; }
    .band::before { left: calc(max(0px, calc(50% - var(--col) / 2)) - 0.22rem); }
    .band::after { right: calc(max(0px, calc(50% - var(--col) / 2)) - 0.22rem); }

    /* ---------- Top bar ---------- */
    .top { position: sticky; top: 0; z-index: 20; background: color-mix(in oklab, var(--bg) 82%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
    .top .inner { display: flex; align-items: center; justify-content: space-between; min-height: 3.5rem; gap: 1rem; }
    .brand { font: 400 1.375rem/1 var(--serif); color: var(--ink); padding: 0.25rem 0; }
    .top nav { display: flex; align-items: center; gap: 0.25rem; }
    .top nav a { font-size: 0.8125rem; color: var(--muted); padding: 0.4rem 0.55rem; border-radius: 6px; transition: color 150ms var(--ease); }
    .top nav a:hover { color: var(--ink); }
    .icon-btn { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 999px; border: 1px solid var(--line-2); background: transparent; color: var(--ink-2); cursor: pointer; transition: color 150ms var(--ease), border-color 150ms var(--ease), transform 100ms var(--ease); }
    .icon-btn:hover { color: var(--ink); border-color: var(--muted); }
    .icon-btn:active { transform: scale(0.94); }
    @media (max-width: 40rem) { .top nav a { display: none; } }

    /* ---------- Banner: Dubai sunset to Melbourne dawn ---------- */
    .banner { margin-top: 1rem; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; position: relative; aspect-ratio: 1000 / 320; background: #142A44; }
    .banner svg { display: block; width: 100%; height: 100%; }
    .banner .city { font-family: var(--serif); fill: #FFF6EC; }
    .banner .tag { font-family: var(--mono); fill: rgba(255, 246, 236, 0.7); letter-spacing: 0.08em; }
    .route { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.4rem 1.25rem; margin-top: 0.7rem; }
    .route div { display: grid; gap: 0.2rem; align-content: start; }
    .route h3 { font: 500 0.75rem/1.2 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; display: flex; align-items: center; gap: 0.4rem; }
    .route h3::before { content: ""; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: currentColor; }
    .route .dxb h3 { color: var(--dxb); } .route .mel h3 { color: var(--mel); text-align: right; justify-content: flex-end; }
    .route .mel { text-align: right; }
    .route ol { list-style: none; padding: 0; font: 400 0.75rem/1.55 var(--mono); color: var(--muted); }

    /* ---------- Profile header ---------- */
    .profile { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 1rem; align-items: center; padding-block: 1.25rem 1.5rem; }
    .avatar { width: 4.25rem; height: 4.25rem; border-radius: 16px; border: 2px solid transparent; background: linear-gradient(var(--surface), var(--surface)) padding-box, linear-gradient(135deg, var(--dxb), var(--mel)) border-box; display: grid; place-items: center; font: 400 1.75rem/1 var(--serif); color: var(--ink); overflow: hidden; }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }
    .profile h1 { font: 400 clamp(2rem, 5vw, 2.6rem)/1 var(--serif); color: var(--ink); letter-spacing: -0.01em; }
    .profile .role { font: 400 0.8125rem/1.4 var(--mono); color: var(--ink-2); margin-top: 0.35rem; }
    .meta { display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; margin-top: 0.4rem; font: 400 0.75rem/1.4 var(--mono); color: var(--muted); }
    .meta span { display: inline-flex; align-items: center; gap: 0.35rem; }
    .dot { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--live); }
    @media (prefers-reduced-motion: no-preference) { .dot { animation: ping 2.4s var(--ease) infinite; } }
    @keyframes ping { 0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--live) 55%, transparent); } 70%, 100% { box-shadow: 0 0 0 6px transparent; } }
    .kbd-btn { display: inline-flex; align-items: center; gap: 0.4rem; height: 2rem; padding: 0 0.65rem; border: 1px solid var(--line-2); border-radius: 8px; background: var(--surface); color: var(--muted); font: 400 0.75rem/1 var(--mono); cursor: pointer; transition: color 150ms var(--ease), border-color 150ms var(--ease), transform 100ms var(--ease); }
    .kbd-btn:hover { color: var(--ink); border-color: var(--muted); }
    .kbd-btn:active { transform: scale(0.96); }
    @media (max-width: 34rem) { .profile { grid-template-columns: auto minmax(0, 1fr); } .profile .kbd-btn { display: none; } }

    /* ---------- Section heads ---------- */
    .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-block: 1.1rem; }
    .sec-head h2 { font: 400 1.75rem/1.1 var(--serif); color: var(--ink); }
    .sec-head .aside { font: 400 0.75rem/1.4 var(--mono); color: var(--muted); text-align: right; }
    .sec-body { padding-block: 1.5rem 2.25rem; }

    /* ---------- About ---------- */
    .bullets { list-style: none; padding: 0; display: grid; gap: 0.9rem; }
    .bullets li { position: relative; padding-left: 1.1rem; max-width: 62ch; }
    .bullets li::before { content: ""; position: absolute; left: 0; top: 0.7em; width: 0.3rem; height: 0.3rem; border-radius: 50%; background: var(--muted); }
    .bullets strong { color: var(--ink); font-weight: 500; }
    .ilink { color: var(--ink); border-bottom: 1px solid var(--line-2); transition: border-color 150ms var(--ease); }
    .ilink:hover { border-color: var(--ink); }
    .snapshot { margin-top: 1.5rem; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding: 1rem 1.1rem; }
    .snapshot h3 { font: 500 0.75rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.8rem; }
    .snapshot dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem 1.5rem; }
    .snapshot div { display: grid; gap: 0.1rem; }
    .snapshot dt { font: 400 0.75rem/1.3 var(--mono); color: var(--muted); }
    .snapshot dd { color: var(--ink); font-size: 0.875rem; }
    @media (max-width: 34rem) { .snapshot dl { grid-template-columns: minmax(0, 1fr); } }

    .links { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .pill { display: inline-flex; align-items: center; gap: 0.45rem; height: 2.125rem; padding: 0 0.8rem; border: 1px solid var(--line-2); border-radius: 999px; background: var(--surface); color: var(--ink-2); font: 400 0.8125rem/1 var(--sans); cursor: pointer; transition: color 150ms var(--ease), border-color 150ms var(--ease), transform 100ms var(--ease); }
    .pill:hover { color: var(--ink); border-color: var(--muted); }
    .pill:active { transform: scale(0.97); }
    .pill--solid { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    .pill--solid:hover { color: var(--bg); opacity: 0.9; }
    .pill .done { display: none; }
    .pill.is-done .label { display: none; }
    .pill.is-done .done { display: inline; color: var(--live); }

    /* ---------- Projects ---------- */
    .filters { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.1rem; }
    .filters button { font: 400 0.75rem/1 var(--mono); color: var(--muted); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 0.45rem 0.75rem; cursor: pointer; transition: color 150ms var(--ease), border-color 150ms var(--ease), background-color 150ms var(--ease); }
    .filters button:hover { color: var(--ink); }
    .filters button[aria-pressed="true"] { color: var(--ink); background: var(--surface-2); border-color: var(--line-2); }
    .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem; }
    @media (max-width: 40rem) { .cards { grid-template-columns: minmax(0, 1fr); } }
    .card { --c: var(--ink); border: 1px solid var(--line); border-radius: 14px; background: var(--surface); padding: 0.7rem; display: flex; flex-direction: column; transition: border-color 200ms var(--ease); position: relative; }
    .card:hover { border-color: color-mix(in oklab, var(--c) 45%, var(--line-2)); }
    .card .preview { background: radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--c) 16%, transparent), transparent 60%), var(--bg) repeating-linear-gradient(-45deg, var(--hatch) 0 1px, transparent 1px 9px); }
    .card-title { display: flex; align-items: center; gap: 0.6rem; }
    .tile-icon { width: 2rem; height: 2rem; flex: none; border-radius: 9px; display: grid; place-items: center; color: #fff; background: linear-gradient(145deg, color-mix(in oklab, var(--c) 92%, #fff), color-mix(in oklab, var(--c) 70%, #000)); box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 4px 12px -4px color-mix(in oklab, var(--c) 60%, transparent); }
    .tile-icon svg { width: 1rem; height: 1rem; }
    .card[hidden] { display: none; }
    .card--wide { grid-column: 1 / -1; }
    .preview { position: relative; border: 1px solid var(--line); border-radius: 10px; min-height: 11.5rem; padding: 2.4rem 0.9rem 0.9rem; background: var(--bg) repeating-linear-gradient(-45deg, var(--hatch) 0 1px, transparent 1px 9px); overflow: hidden; display: flex; flex-direction: column; justify-content: center; }
    .badges { position: absolute; top: 0.6rem; left: 0.6rem; right: 0.6rem; display: flex; justify-content: space-between; gap: 0.5rem; }
    .badge { display: inline-flex; align-items: center; gap: 0.35rem; height: 1.35rem; padding: 0 0.45rem; border-radius: 5px; font: 500 0.75rem/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; border: 1px solid; }
    .badge--live { color: var(--live); background: var(--live-soft); border-color: color-mix(in oklab, var(--live) 35%, transparent); }
    .badge--live::before { content: ""; width: 0.35rem; height: 0.35rem; border-radius: 50%; background: currentColor; }
    .badge--wip { color: var(--warm); background: var(--warm-soft); border-color: color-mix(in oklab, var(--warm) 35%, transparent); }
    .badge--data { color: var(--muted); background: var(--surface); border-color: var(--line-2); }
    .card-body { padding: 0.9rem 0.35rem 0.25rem; display: flex; flex-direction: column; gap: 0.45rem; flex: 1; }
    .card-body h3 { font: 500 1rem/1.3 var(--sans); color: var(--ink); }
    .card-body p { font-size: 0.875rem; }
    .eng summary { cursor: pointer; list-style: none; font: 400 0.75rem/1 var(--mono); color: var(--muted); display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.3rem 0; transition: color 150ms var(--ease); }
    .eng summary::-webkit-details-marker { display: none; }
    .eng summary:hover { color: var(--ink); }
    .eng summary::after { content: "+"; transition: transform 200ms var(--ease); display: inline-block; }
    .eng[open] summary::after { transform: rotate(45deg); }
    .eng p { margin-top: 0.4rem; font-size: 0.8125rem; }
    .card-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 0.75rem; margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--line); }
    .chips { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    .chip { font: 400 0.75rem/1 var(--mono); color: var(--ink-2); border: 1px solid var(--line-2); border-radius: 5px; padding: 0.3rem 0.45rem; background: var(--bg); }
    .card-foot .icon-btn { width: 1.9rem; height: 1.9rem; flex: none; }

    .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; }
    .stats div { border: 1px solid var(--line-2); border-radius: 10px; background: var(--surface); padding: 0.8rem 0.9rem; display: grid; gap: 0.25rem; }
    .stats b { font: 400 clamp(1.5rem, 4vw, 2.1rem)/1 var(--serif); color: var(--ink); }
    .stats span { font: 400 0.75rem/1.35 var(--mono); color: var(--muted); }
    .yield { margin-top: 0.8rem; display: grid; gap: 0.35rem; font: 400 0.75rem/1.3 var(--mono); color: var(--muted); }
    .yield .bar { position: relative; height: 0.6rem; border-radius: 99px; background: var(--line); }
    .yield .bar i { position: absolute; top: 0; bottom: 0; left: var(--a); right: var(--b); border-radius: 99px; background: var(--c-dubai); }
    .yield .ends { display: flex; justify-content: space-between; }
    @media (max-width: 34rem) { .stats { grid-template-columns: minmax(0, 1fr); } }
    .seg { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 0.7rem; }
    .seg button { font: 400 0.75rem/1 var(--mono); color: var(--muted); background: var(--surface); border: 1px solid var(--line); border-radius: 5px; padding: 0.35rem 0.5rem; cursor: pointer; transition: color 150ms var(--ease), border-color 150ms var(--ease), transform 100ms var(--ease); }
    .seg button:hover { color: var(--ink); }
    .seg button:active { transform: scale(0.95); }
    .seg button[aria-pressed="true"] { color: var(--ink); border-color: var(--muted); }
    .ex-read { font: 400 0.75rem/1.3 var(--mono); color: var(--muted); margin-bottom: 0.5rem; }
    .ex-read b { color: var(--ink); font-weight: 500; }
    .bars { list-style: none; padding: 0; display: grid; gap: 0.32rem; }
    .bars li { display: grid; grid-template-columns: 5.2rem minmax(0, 1fr) 2.4rem; align-items: center; gap: 0.6rem; font: 400 0.75rem/1.2 var(--mono); }
    .bars .k { color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bars .track { height: 0.45rem; border-radius: 99px; background: var(--line); overflow: hidden; }
    .bars .fill { display: block; height: 100%; border-radius: 99px; background: var(--c-jobs); transform-origin: left; transform: scaleX(var(--v, 0)); transition: transform 520ms var(--ease); transition-delay: calc(var(--i, 0) * 30ms); }
    .bars .n { text-align: right; color: var(--muted); }
    .ex-note { margin-top: 0.6rem; font: 400 0.75rem/1.45 var(--mono); color: var(--muted); }

    .dotplot { list-style: none; padding: 0; display: grid; gap: 0.2rem; }
    .dotplot li { display: grid; grid-template-columns: 5.6rem minmax(0, 1fr) 2rem; align-items: center; gap: 0.5rem; font: 400 0.75rem/1.2 var(--mono); }
    .dotplot .k { color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dotplot .axis { position: relative; height: 0.85rem; background: linear-gradient(var(--line-2), var(--line-2)) center / 100% 1px no-repeat; }
    .dotplot .pt { position: absolute; top: 50%; left: var(--x); width: 0.5rem; height: 0.5rem; margin: -0.25rem 0 0 -0.25rem; border-radius: 50%; background: var(--ink); }
    .dotplot .pt { background: color-mix(in oklab, var(--c-beats) 55%, var(--ink)); }
    .dotplot li:first-child .pt { background: var(--c-beats); }
    .dotplot .n { text-align: right; color: var(--ink); }
    .scale { display: grid; grid-template-columns: 5.6rem minmax(0, 1fr) 2rem; gap: 0.5rem; font: 400 0.75rem/1 var(--mono); color: var(--muted); margin-top: 0.35rem; }
    .scale span:nth-child(2) { display: flex; justify-content: space-between; }

    .flow { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
    .flow--row { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .flow li { border: 1px solid var(--line-2); border-radius: 8px; background: var(--surface); padding: 0.5rem 0.6rem; display: grid; gap: 0.15rem; }
    .flow .s { font: 400 0.75rem/1 var(--mono); color: var(--muted); }
    .flow strong { font: 500 0.8125rem/1.2 var(--sans); color: var(--ink); }
    .flow span:last-child { font: 400 0.75rem/1.35 var(--mono); color: var(--muted); }
    .flow li.out { border-color: color-mix(in oklab, var(--c-runway) 50%, var(--line-2)); background: color-mix(in oklab, var(--c-runway) 12%, transparent); }
    @media (max-width: 34rem) { .flow--row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

    /* ---------- Experience ---------- */
    .jobs { list-style: none; padding: 0; display: grid; }
    .job { display: grid; grid-template-columns: 2.6rem minmax(0, 1fr); gap: 0.9rem; padding-block: 1.1rem; border-bottom: 1px dashed var(--line-2); }
    .job:first-child { padding-top: 0; }
    .job:last-child { border-bottom: 0; padding-bottom: 0; }
    .mark { width: 2.6rem; height: 2.6rem; border-radius: 10px; display: grid; place-items: center; font: 400 1.2rem/1 var(--serif); color: var(--city); background: color-mix(in oklab, var(--city) 13%, var(--surface)); border: 1px solid color-mix(in oklab, var(--city) 40%, var(--line-2)); }
    .job.dxb { --city: var(--dxb); } .job.mel { --city: var(--mel); }
    .when-wrap { display: grid; justify-items: end; gap: 0.3rem; }
    .dur { font: 500 0.75rem/1 var(--mono); color: var(--city); background: color-mix(in oklab, var(--city) 12%, transparent); border: 1px solid color-mix(in oklab, var(--city) 35%, transparent); border-radius: 999px; padding: 0.25rem 0.5rem; white-space: nowrap; }
    .job .city-name { color: var(--city); }
    .job-top { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
    .job h3 { font: 500 0.9375rem/1.35 var(--sans); color: var(--ink); }
    .job h3 span { color: var(--muted); font-weight: 400; }
    .job .when { font: 400 0.75rem/1 var(--mono); color: var(--muted); white-space: nowrap; }
    .job .where { font: 400 0.75rem/1.4 var(--mono); color: var(--muted); margin-top: 0.2rem; }
    .job ul { margin-top: 0.6rem; padding-left: 1rem; display: grid; gap: 0.3rem; font-size: 0.875rem; }
    .job li::marker { color: var(--line-2); }

    /* ---------- Now ---------- */
    .now { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; }
    .now li { border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding: 0.9rem 1rem; display: grid; gap: 0.35rem; align-content: start; position: relative; overflow: hidden; }
    .now li::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 2px; background: var(--k); }
    .now .k { font: 500 0.75rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--k); }
    .now .v { font-size: 0.875rem; color: var(--ink); }
    @media (max-width: 40rem) { .now { grid-template-columns: minmax(0, 1fr); } }

    /* ---------- Research ---------- */
    .papers { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
    .paper { display: block; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding: 0.9rem 1rem; transition: border-color 200ms var(--ease); }
    a.paper:hover { border-color: var(--line-2); }
    .paper-top { display: flex; justify-content: space-between; gap: 1rem; font: 400 0.75rem/1.3 var(--mono); color: var(--muted); }
    .paper h3 { margin-top: 0.4rem; font: 500 0.9375rem/1.4 var(--sans); color: var(--ink); }
    .paper p { margin-top: 0.3rem; font-size: 0.8125rem; }
    .certs { margin-top: 1.4rem; }
    .certs h3 { font: 500 0.75rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.6rem; }
    .certs ul { list-style: none; padding: 0; }
    .certs li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px dashed var(--line-2); font-size: 0.875rem; }
    .certs li:last-child { border-bottom: 0; }
    .certs li span:first-child { color: var(--ink); }
    .certs li span:last-child { font: 400 0.75rem/1.5 var(--mono); color: var(--muted); white-space: nowrap; }

    /* ---------- GitHub ---------- */
    .gh { display: block; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); padding: 1.5rem 1.4rem 1.2rem; transition: border-color 200ms var(--ease); }
    .gh:hover { border-color: var(--line-2); }
    .graph-svg { display: block; width: 100%; height: auto; }
    .gh-link { display: inline-flex; gap: 0.4rem; margin-top: 1.1rem; font: 400 0.875rem/1 var(--mono); color: var(--live); }
    .gh-link span { transition: transform 200ms var(--ease); }
    .gh:hover .gh-link span { transform: translateX(3px); }
    @media (prefers-reduced-motion: reduce) { .gh:hover .gh-link span { transform: none; } }

    /* ---------- Contact ---------- */
    .cta { text-align: center; padding-block: 2.5rem 2.75rem; }
    .cta h2 { font: 400 clamp(2rem, 6vw, 2.75rem)/1.05 var(--serif); color: var(--ink); }
    .cta p { margin: 0.7rem auto 1.4rem; max-width: 44ch; }
    .cta .links { justify-content: center; }
    footer .inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-block: 1.1rem 1.6rem; font: 400 0.75rem/1.4 var(--mono); color: var(--muted); }

    /* ---------- Sticky index ---------- */
    .index { position: fixed; top: 7.5rem; left: calc(50% + var(--col) / 2 + 2.5rem); display: none; z-index: 5; }
    @media (min-width: 76rem) { .index { display: block; } }
    .index h2 { font: 500 0.75rem/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.9rem; }
    .index ol { list-style: none; padding: 0; display: grid; gap: 0.15rem; }
    .index a { display: flex; align-items: center; gap: 0.55rem; font: 400 0.75rem/1 var(--mono); color: var(--muted); padding: 0.4rem 0; transition: color 200ms var(--ease); }
    .index a::before { content: ""; width: 0; height: 1px; background: var(--ink); transition: width 250ms var(--ease); }
    .index a:hover { color: var(--ink-2); }
    .index a[aria-current="true"] { color: var(--ink); }
    .index a[aria-current="true"]::before { width: 0.9rem; }

    /* ---------- Command palette ---------- */
    dialog.pal { width: min(34rem, calc(100% - 2rem)); margin: 14vh auto auto; padding: 0; border: 1px solid var(--line-2); border-radius: 14px; background: var(--surface); color: var(--ink-2); box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.5); }
    dialog.pal::backdrop { background: rgba(0, 0, 0, 0.45); backdrop-filter: blur(2px); }
    dialog.pal[open] { animation: pop 170ms var(--ease); transform-origin: top center; }
    @keyframes pop { from { opacity: 0; transform: scale(0.97) translateY(-4px); } to { opacity: 1; transform: none; } }
    .pal input { width: 100%; font: 400 0.9375rem/1.4 var(--sans); color: var(--ink); background: transparent; border: 0; border-bottom: 1px solid var(--line); padding: 0.95rem 1.1rem; }
    .pal input:focus-visible { outline: none; }
    .pal ul { list-style: none; padding: 0.4rem; margin: 0; max-height: 21rem; overflow-y: auto; }
    .pal li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0.75rem; border-radius: 8px; cursor: pointer; font-size: 0.875rem; }
    .pal li[hidden] { display: none; }
    .pal li .g { font: 400 0.75rem/1.6 var(--mono); color: var(--muted); }
    .pal li[aria-selected="true"] { background: var(--surface-2); color: var(--ink); }
    .pal .empty { padding: 0.9rem 1.1rem; font-size: 0.875rem; }

    /* ---------- Entrance: blur-fade, staggered ---------- */
    @media (prefers-reduced-motion: no-preference) {
      html.js .enter { opacity: 0; filter: blur(6px); transform: translateY(8px); }
      html.js.ready .enter { opacity: 1; filter: none; transform: none; transition: opacity 600ms var(--ease), filter 600ms var(--ease), transform 600ms var(--ease); transition-delay: calc(var(--d, 0) * 70ms); }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .bars .fill, .index a::before { transition: none; }
      dialog.pal[open] { animation: none; }
    }
  </style>
</head>
<body>
  <header class="top">
    <div class="col inner">
      <a class="brand" href="#top" id="top">{profile.name.split(' ')[0]}</a>
      <nav aria-label="Primary">
        <a href="#work">Projects</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
        <button class="icon-btn" type="button" data-open-palette aria-label="Search the site" set:html={icon.search}></button>
        <button class="icon-btn" type="button" id="theme" aria-label="Switch light or dark" set:html={icon.sun}></button>
      </nav>
    </div>
  </header>

  <aside class="index" aria-label="On this page">
    <h2>Index</h2>
    <ol>{sections.map(([id, label]) => <li><a href={`#${id}`} data-index={id}>{label}</a></li>)}</ol>
  </aside>

  <main class="frame">
    <div class="col inner">
      <figure class="banner enter" style="--d:0" aria-labelledby="journey-cap">
        <svg viewBox="0 0 1000 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <linearGradient id="sky" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="#E9774F" /><stop offset="0.3" stop-color="#8A4256" /><stop offset="0.55" stop-color="#1B2B48" /><stop offset="0.8" stop-color="#1F4573" /><stop offset="1" stop-color="#4F86BD" />
            </linearGradient>
            <linearGradient id="shade" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#0B1020" stop-opacity="0.55" /><stop offset="0.7" stop-color="#0B1020" stop-opacity="0" /></linearGradient>
            <radialGradient id="sun" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#FFE2A8" /><stop offset="0.45" stop-color="#FFB46B" stop-opacity="0.85" /><stop offset="1" stop-color="#FF8A5B" stop-opacity="0" /></radialGradient>
            <radialGradient id="dawn" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#CFE6FF" stop-opacity="0.9" /><stop offset="1" stop-color="#7CB8FF" stop-opacity="0" /></radialGradient>
            <path id="route" d="M190 238 Q 500 -10 812 238" />
          </defs>
          <rect width="1000" height="320" fill="url(#sky)" />
          <rect width="1000" height="320" fill="url(#shade)" />
          {stars.map((t) => <circle cx={t.x.toFixed(1)} cy={t.y.toFixed(1)} r={t.r.toFixed(2)} fill="#fff" opacity={t.o.toFixed(2)} />)}
          <circle cx="150" cy="292" r="120" fill="url(#sun)" />
          <circle cx="880" cy="300" r="110" fill="url(#dawn)" />
          <use href="#route" fill="none" stroke="#FFF6EC" stroke-opacity="0.45" stroke-width="1.6" stroke-dasharray="2 7" stroke-linecap="round" />
          <g fill="#0C1322">
            {dxb.map((b) => <rect x={b.x.toFixed(1)} y={(300 - b.h).toFixed(1)} width={b.w.toFixed(1)} height={b.h.toFixed(1)} rx="1.5" />)}
            <path d="M238 300 L238 150 L243 150 L243 112 L247 112 L247 78 L250 78 L250 40 L252 14 L254 40 L254 78 L257 78 L257 112 L261 112 L261 150 L266 150 L266 300 Z" />
            {mel.map((b) => <rect x={b.x.toFixed(1)} y={(300 - b.h).toFixed(1)} width={b.w.toFixed(1)} height={b.h.toFixed(1)} rx="1.5" />)}
            <path d="M716 300 L716 110 L722 102 L742 102 L748 110 L748 300 Z" />
            <rect x="0" y="298" width="1000" height="22" />
          </g>
          <rect x="718" y="102" width="28" height="10" fill="#F5C76A" opacity="0.9" />
          <g fill="#FFD58A">{lights.map((l) => <rect x={l.x.toFixed(1)} y={l.y.toFixed(1)} width="2.2" height="2.2" opacity="0.75" />)}</g>
          <circle cx="190" cy="238" r="5" fill="#FF8A5B" stroke="#FFF6EC" stroke-width="2" />
          <circle cx="812" cy="238" r="5" fill="#7CB8FF" stroke="#FFF6EC" stroke-width="2" />
          <g id="plane">
            <path d="M-11 0 L9 0 M3 -7 L-3 0 L3 7 M-9 -3.5 L-11 0 L-9 3.5" fill="none" stroke="#FFF6EC" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            <animateMotion dur="11s" repeatCount="indefinite" rotate="auto" keyPoints="0;1;1;0;0" keyTimes="0;0.42;0.5;0.92;1" calcMode="spline" keySplines="0.45 0 0.55 1;0 0 1 1;0.45 0 0.55 1;0 0 1 1"><mpath href="#route" /></animateMotion>
          </g>
          <text class="city" x="44" y="62" font-size="40">Dubai</text>
          <text class="tag" x="46" y="86" font-size="12">25.2°N  HOME</text>
          <text class="city" x="956" y="62" font-size="40" text-anchor="end">Melbourne</text>
          <text class="tag" x="954" y="86" font-size="12" text-anchor="end">37.8°S  STUDY AND WORK</text>
        </svg>
      </figure>
      <div class="route enter" style="--d:1" id="journey-cap">
        <div class="dxb"><h3>UAE</h3><ol>{profile.journey.UAE.map((t) => <li>{t}</li>)}</ol></div>
        <div class="mel"><h3>Melbourne</h3><ol>{profile.journey.Melbourne.map((t) => <li>{t}</li>)}</ol></div>
      </div>

      <div class="profile">
        <div class="avatar enter" style="--d:2" aria-hidden="true">{profile.photo ? <img src={profile.photo} alt="" width="68" height="68" /> : initials}</div>
        <div class="enter" style="--d:3">
          <h1>{profile.name}</h1>
          <p class="role">{profile.role}</p>
          <p class="meta">
            <span>Dubai, UAE</span>
            <span id="clock">GST</span>
            <span><i class="dot" aria-hidden="true"></i>Open to work</span>
          </p>
        </div>
        <button class="kbd-btn enter" style="--d:4" type="button" data-open-palette><span set:html={icon.search} /> ⌘K</button>
      </div>
    </div>

    <div class="band" aria-hidden="true"></div>

    <section id="about" aria-labelledby="about-h">
      <div class="col inner sec-head"><h2 id="about-h">About</h2></div>
      <div class="rule"></div>
      <div class="col inner sec-body">
        <ul class="bullets">
          <li>I'm based in the UAE and I build with large language models and data. I've fine-tuned GPT models and built prompt and evaluation pipelines for education and insurance use cases, taking each from a business goal to a working prototype.</li>
          <li>At <strong>Remunera</strong> I built Python pipelines that scrape and clean prospect data, automated tailored outreach with the GPT API, and tracked the funnel in dashboards. Lately I've been digging into <strong>Dubai's property market</strong>: 1.8 million transactions and the AED 2 million Golden Visa line.</li>
          <li>I publish too. My latest is a <a class="ilink" href={profile.publications[0].url}>2026 book chapter</a> on generative AI in dark web policing, alongside two IEEE conference papers.</li>
        </ul>
        <div class="snapshot">
          <h3>At a glance</h3>
          <dl>{profile.glance.map((g) => <div><dt>{g.label}</dt><dd>{g.value}</dd></div>)}<div><dt>Open to</dt><dd>Roles in the UAE and remote</dd></div></dl>
        </div>
        <div class="links" style="margin-top:1.25rem">
          <button class="pill pill--solid" type="button" data-copy="email" data-value={profile.contact.email}><span set:html={icon.mail} /><span class="label">Copy email</span><span class="done">Copied</span></button>
          <button class="pill" type="button" data-copy="prompt" data-value={prompt} title="Copies a prompt that points your AI assistant at my llms.txt"><span set:html={icon.spark} /><span class="label">Ask your AI about me</span><span class="done">Prompt copied</span></button>
          <a class="pill" href={profile.contact.github}><span set:html={icon.github} />GitHub</a>
          <a class="pill" href={profile.contact.linkedin}><span set:html={icon.linkedin} />LinkedIn</a>
          <a class="pill" href={profile.scholar}><span set:html={icon.scholar} />Scholar</a>
        </div>
      </div>
    </section>

    <div class="band" aria-hidden="true"></div>

    <section id="now" aria-labelledby="now-h">
      <div class="col inner sec-head"><h2 id="now-h">Now</h2><span class="aside">November 2026</span></div>
      <div class="rule"></div>
      <div class="col inner sec-body">
        <ul class="now">
          {profile.now.map((n, i) => <li style={`--k:${['var(--dxb)', 'var(--mel)', 'var(--live)'][i % 3]}`}><span class="k">{n.k}</span><span class="v">{n.v}</span></li>)}
        </ul>
      </div>
    </section>

    <div class="band" aria-hidden="true"></div>

    <section id="work" aria-labelledby="work-h">
