      <div class="rule"></div>
      <div class="col inner sec-body">
        <div class="cards">
          {bySlug['dubai-real-estate'] && (() => { const p = bySlug['dubai-real-estate']; return (
            <article class="card card--wide" data-tags="data" style="--c:var(--c-dubai)">
              <div class="preview">
                <div class="badges"><span class="badge badge--live">Live</span><span class="badge badge--data">Dubai Land Department data</span></div>
                <div class="stats">
                  <div><b>1.8M</b><span>sales transactions</span></div>
                  <div><b>10.7M</b><span>rent contract lines</span></div>
                  <div><b>AED 2M</b><span>Golden Visa line studied</span></div>
                </div>
                <div class="yield" aria-label="Estimated rental yield at AED 2 million: 5.2 to 6.4 percent">
                  <span>Estimated rental yield at AED 2M</span>
                  <span class="bar"><i style="--a:52%;--b:36%"></i></span>
                  <span class="ends"><span>0%</span><span>5.2 to 6.4%</span><span>10%</span></span>
                </div>
              </div>
              <div class="card-body">
                <div class="card-title"><span class="tile-icon" set:html={'<svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M4 21V9l5-3v15M9 21V4l6 3v14M15 21v-9l5 2v7M2 21h20"/></svg>'} /><h3>{p.name}</h3></div>
                <p>{p.tagline}. The ranking was backtested across four rounds, 2022 to 2025.</p>
                <details class="eng"><summary>Show engineering details</summary><p>{p.description}</p></details>
                <div class="card-foot"><div class="chips">{p.stack.map((t) => <span class="chip">{t}</span>)}</div><span style="display:flex;gap:0.4rem"><a class="icon-btn" href={p.demo} aria-label="Open the live Dubai data page" set:html={'<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>'}></a><a class="icon-btn" href={p.repo} aria-label={`${p.name} on GitHub`} set:html={icon.github}></a></span></div>
              </div>
            </article>
          ); })()}

          {bySlug['job-market-insights'] && (() => { const p = bySlug['job-market-insights']; return (
            <article class="card card--wide" data-tags="data" style="--c:var(--c-jobs)">
              <div class="preview" id="explorer">
                <div class="badges"><span class="badge badge--live">Shipped</span><span class="badge badge--data">Live data</span></div>
                <div class="seg" role="group" aria-label="Filter by state">
                  {jm.views.map((v, i) => <button type="button" data-view={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>{v.label}</button>)}
                </div>
                <p class="ex-read" aria-live="polite"><b id="ex-ads">{num(all.ads)}</b> ads in <span id="ex-place">{all.name}</span>, top skills</p>
                <ol class="bars" id="ex-bars">
                  {all.skills.map(([k, n], i) => <li style={`--i:${i}`}><span class="k">{k}</span><span class="track"><span class="fill" style={`--v:${(n / maxAll).toFixed(3)}`}></span></span><span class="n">{num(n)}</span></li>)}
                </ol>
                <p class="ex-note">Go is left out: {num(jm.note.tagged)} ads were tagged with it, only {num(jm.note.genuine)} mean the language.</p>
              </div>
              <div class="card-body">
                <div class="card-title"><span class="tile-icon" set:html={'<svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M5 19V11M10 19V6M15 19v-9M20 19V4"/></svg>'} /><h3>{p.name}</h3></div>
                <p>{p.tagline}. I led the team, scraped every ad and wrote most of the code. Pick a state above: the chart runs on the cleaned dataset.</p>
                <details class="eng"><summary>Show engineering details</summary><p>{p.description}</p></details>
                <div class="card-foot"><div class="chips">{p.stack.map((t) => <span class="chip">{t}</span>)}</div><a class="icon-btn" href={p.repo} aria-label={`${p.name} on GitHub`} set:html={icon.github}></a></div>
              </div>
            </article>
          ); })()}

          {bySlug['beats-externship'] && (() => { const p = bySlug['beats-externship']; return (
            <article class="card" data-tags="data nlp" style="--c:var(--c-beats)">
              <div class="preview">
                <div class="badges"><span class="badge badge--live">Shipped</span><span class="badge badge--data">{num(beats.reviews)} reviews</span></div>
                <ol class="dotplot" aria-label="Average star rating per product">
                  {beats.products.map(([k, m]) => <li><span class="k">{k}</span><span class="axis"><span class="pt" style={`--x:${ax(m)}`}></span></span><span class="n">{m.toFixed(2)}</span></li>)}
                </ol>
                <div class="scale" aria-hidden="true"><span></span><span><span>3.5</span><span>4.0</span><span>4.5</span></span><span></span></div>
              </div>
              <div class="card-body">
                <div class="card-title"><span class="tile-icon" set:html={'<svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 15v-3a8 8 0 0 1 16 0v3M4 15a2 2 0 0 0 2 2h1v-5H6a2 2 0 0 0-2 2Zm16 0a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Z"/></svg>'} /><h3>{p.name}</h3></div>
                <p>{p.tagline}.</p>
                <details class="eng"><summary>Show engineering details</summary><p>{p.description}</p></details>
                <div class="card-foot"><div class="chips">{p.stack.slice(0, 3).map((t) => <span class="chip">{t}</span>)}</div><a class="icon-btn" href={p.repo} aria-label={`${p.name} on GitHub`} set:html={icon.github}></a></div>
              </div>
            </article>
          ); })()}

          {bySlug['runway-radar'] && (() => { const p = bySlug['runway-radar']; return (
            <article class="card" data-tags="nlp llm" style="--c:var(--c-runway)">
              <div class="preview" role="img" aria-label="Runway Radar pipeline: runway images and editorial text feed one trend score">
                <div class="badges"><span class="badge badge--live">Shipped</span><span class="badge badge--data">Multi-modal</span></div>
                <ol class="flow">
                  <li><span class="s">image</span><strong>Runway shots</strong><span>CLIP-style embeddings, palettes</span></li>
                  <li><span class="s">text</span><strong>Editorial copy</strong><span>Transformer and VADER sentiment</span></li>
                  <li class="out"><span class="s">score</span><strong>Rising or declining</strong><span>Styles, colours, brands</span></li>
                </ol>
              </div>
              <div class="card-body">
                <div class="card-title"><span class="tile-icon" set:html={'<svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M8 3 4 6l2 4 2-1v12h8V9l2 1 2-4-4-3c-.5 1.5-2 2.5-4 2.5S8.5 4.5 8 3Z"/></svg>'} /><h3>{p.name}</h3></div>
                <p>{p.tagline}.</p>
                <details class="eng"><summary>Show engineering details</summary><p>{p.description}</p></details>
                <div class="card-foot"><div class="chips">{p.stack.slice(0, 3).map((t) => <span class="chip">{t}</span>)}</div><a class="icon-btn" href={p.repo} aria-label={`${p.name} on GitHub`} set:html={icon.github}></a></div>
              </div>
            </article>
          ); })()}

        </div>
      </div>
    </section>

    <div class="band" aria-hidden="true"></div>

    <section id="experience" aria-labelledby="exp-h">
      <div class="col inner sec-head"><h2 id="exp-h">Experience</h2><span class="aside"><span style="color:var(--dxb)">Dubai</span> and <span style="color:var(--mel)">Melbourne</span></span></div>
      <div class="rule"></div>
      <div class="col inner sec-body">
        <ol class="jobs">
          {profile.experience.map((j) => (
            <li class={`job ${cityOf(j.place)}`}>
              <span class="mark" aria-hidden="true">{j.org[0]}</span>
              <div>
                <div class="job-top"><h3>{j.role} <span>at {j.org}</span></h3><span class="when-wrap"><span class="when">{j.start} to {j.end}</span><span class="dur">{duration(j.start, j.end)}</span></span></div>
                <p class="where">{j.place}</p>
                <ul>{j.points.map((pt) => <li>{pt}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <div class="band" aria-hidden="true"></div>

    <section id="research" aria-labelledby="res-h">
      <div class="col inner sec-head"><h2 id="res-h">Research</h2><a class="aside ilink" href={profile.scholar}>Google Scholar</a></div>
      <div class="rule"></div>
      <div class="col inner sec-body">
        <ol class="papers">
          {profile.publications.map((pub) => (
            <li>
              {pub.url
                ? <a class="paper" href={pub.url}><div class="paper-top"><span>{pub.type}</span><span>{pub.year}</span></div><h3>{pub.title}</h3><p>{pub.venue}</p></a>
                : <div class="paper"><div class="paper-top"><span>{pub.type}</span><span>{pub.year}</span></div><h3>{pub.title}</h3><p>{pub.venue}</p></div>}
            </li>
          ))}
        </ol>
        <div class="certs">
          <h3>Certifications</h3>
          <ul>{profile.certifications.map((c) => <li><span>{c.name}</span><span>{c.issuer}, {c.year}</span></li>)}</ul>
        </div>
      </div>
    </section>

    <div class="band" aria-hidden="true"></div>

    <section id="github" aria-labelledby="gh-h">
      <div class="col inner sec-head"><h2 id="gh-h">GitHub</h2><a class="aside ilink" href={profile.contact.github}>@yousufagha</a></div>
      <div class="rule"></div>
      <div class="col inner sec-body">
        <a class="gh" href={profile.contact.github} aria-label="GitHub profile, yousufagha">
          {graphSvg ? <div role="img" aria-label={`GitHub contribution graph, ${year}`} set:html={graphSvg} /> : <img src="/github-contribution.svg" alt={`GitHub contribution graph, ${year}`} width="747" height="103" style="width:100%;height:auto" />}
          <span class="gh-link">github.com/yousufagha <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>

    <div class="band" aria-hidden="true"></div>

    <section id="contact" aria-labelledby="contact-h">
      <div class="col inner cta">
        <h2 id="contact-h">Scrolled this far?</h2>
        <p>{profile.availability} {profile.workRights}</p>
        <div class="links">
          <a class="pill pill--solid" href={`mailto:${profile.contact.email}`}><span set:html={icon.mail} />{profile.contact.email}</a>
          <button class="pill" type="button" data-copy="email" data-value={profile.contact.email} aria-label="Copy email address"><span set:html={icon.copy} /><span class="label">Copy</span><span class="done">Copied</span></button>
          <a class="pill" href={profile.contact.linkedin}><span set:html={icon.linkedin} />LinkedIn</a>
          <a class="pill" href={profile.contact.x}><span set:html={icon.x} />X</a>
        </div>
      </div>
    </section>

    <div class="rule"></div>
    <footer>
      <div class="col inner"><span>© {year} {profile.name}</span><span>Designed and built by me, in Dubai</span></div>
    </footer>
  </main>

  <dialog class="pal" id="pal" aria-label="Search the site">
    <input type="text" id="pal-q" placeholder="Search projects, sections and actions" autocomplete="off" />
    <ul role="listbox">{palette.map((it, i) => <li role="option" aria-selected={i === 0 ? 'true' : 'false'} data-href={it.href} data-action={it.action}><span>{it.label}</span><span class="g">{it.group}</span></li>)}</ul>
    <p class="empty" hidden>Nothing matches that.</p>
  </dialog>

  <script type="application/json" id="ex-data" set:html={JSON.stringify(jm.views)} />

  <script is:inline>
    (function () {
      var root = document.documentElement;
      requestAnimationFrame(function () { requestAnimationFrame(function () { root.classList.add('ready'); }); });

      var themeBtn = document.getElementById('theme');
      function toggleTheme() {
        var light = root.getAttribute('data-theme') !== 'light';
        if (light) root.setAttribute('data-theme', 'light'); else root.removeAttribute('data-theme');
        try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch (e) {}
        var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', light ? '#FAFAFA' : '#09090B');
      }
      themeBtn.addEventListener('click', toggleTheme);

      var clock = document.getElementById('clock');
      function tick() { try { clock.textContent = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Dubai' }).format(new Date()) + ' GST'; } catch (e) {} }
      tick(); setInterval(tick, 30000);

      var canCopy = !!(navigator.clipboard && window.isSecureContext);
      function copyValue(btn) {
        if (!btn) return;
        var v = btn.getAttribute('data-value');
        if (!canCopy) { if (btn.getAttribute('data-copy') === 'email') location.href = 'mailto:' + v; return; }
        navigator.clipboard.writeText(v).then(function () { btn.classList.add('is-done'); setTimeout(function () { btn.classList.remove('is-done'); }, 1800); });
      }
      document.querySelectorAll('[data-copy]').forEach(function (b) { b.addEventListener('click', function () { copyValue(b); }); });

      /* The plane flies only when motion is welcome. */
      var svgEl = document.querySelector('.banner svg');
      if (svgEl && window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches && svgEl.pauseAnimations) { svgEl.setCurrentTime(2.3); svgEl.pauseAnimations(); }

      var data = JSON.parse(document.getElementById('ex-data').textContent);
      var fmt = new Intl.NumberFormat('en-AU');
      var bars = document.getElementById('ex-bars'), ads = document.getElementById('ex-ads'), place = document.getElementById('ex-place');
      var segs = document.querySelectorAll('.seg button');
      segs.forEach(function (b) {
        b.addEventListener('click', function () {
          var v = data.filter(function (d) { return d.id === b.getAttribute('data-view'); })[0]; if (!v) return;
          var max = v.skills[0][1];
          v.skills.forEach(function (s, i) { var li = bars.children[i]; if (!li) return; li.querySelector('.k').textContent = s[0]; li.querySelector('.n').textContent = fmt.format(s[1]); li.querySelector('.fill').style.setProperty('--v', (s[1] / max).toFixed(3)); });
          ads.textContent = fmt.format(v.ads); place.textContent = v.name;
          segs.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        });
      });

      var filters = document.querySelectorAll('[data-filter]');
      filters.forEach(function (f) {
        f.addEventListener('click', function () {
          var t = f.getAttribute('data-filter');
          document.querySelectorAll('.card').forEach(function (c) { c.hidden = t !== 'all' && (' ' + c.getAttribute('data-tags') + ' ').indexOf(' ' + t + ' ') === -1; });
          filters.forEach(function (x) { x.setAttribute('aria-pressed', x === f ? 'true' : 'false'); });
        });
      });

      var links = {}; document.querySelectorAll('[data-index]').forEach(function (a) { links[a.getAttribute('data-index')] = a; });
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { Object.keys(links).forEach(function (k) { links[k].setAttribute('aria-current', k === e.target.id ? 'true' : 'false'); }); } });
        }, { rootMargin: '-35% 0px -60% 0px' });
        Object.keys(links).forEach(function (id) { var el = document.getElementById(id); if (el) io.observe(el); });
      }

      var dlg = document.getElementById('pal'); if (typeof dlg.showModal !== 'function') return;
      var q = document.getElementById('pal-q'); var items = Array.prototype.slice.call(dlg.querySelectorAll('li')); var empty = dlg.querySelector('.empty');
      function vis() { return items.filter(function (li) { return !li.hidden; }); }
      function sel(i) { var v = vis(); items.forEach(function (li) { li.setAttribute('aria-selected', 'false'); }); if (v[i]) { v[i].setAttribute('aria-selected', 'true'); v[i].scrollIntoView({ block: 'nearest' }); } }
      function cur() { var v = vis(); for (var i = 0; i < v.length; i++) if (v[i].getAttribute('aria-selected') === 'true') return i; return 0; }
      function filter() { var t = q.value.trim().toLowerCase(); items.forEach(function (li) { li.hidden = !!t && li.textContent.toLowerCase().indexOf(t) === -1; }); empty.hidden = vis().length > 0; sel(0); }
      function run(li) {
        var href = li.getAttribute('data-href'), act = li.getAttribute('data-action'); dlg.close();
        if (act === 'theme') toggleTheme();
        else if (act === 'copy-email') copyValue(document.querySelector('[data-copy="email"]'));
        else if (act === 'copy-prompt') copyValue(document.querySelector('[data-copy="prompt"]'));
        else if (href && href.charAt(0) === '#') { var el = document.querySelector(href); if (el) el.scrollIntoView(); history.replaceState(null, '', href); }
        else if (href) location.href = href;
      }
      function open() { q.value = ''; filter(); dlg.showModal(); q.focus(); }
      document.querySelectorAll('[data-open-palette]').forEach(function (b) { b.addEventListener('click', open); });
      document.addEventListener('keydown', function (e) { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? dlg.close() : open(); } });
      q.addEventListener('input', filter);
      q.addEventListener('keydown', function (e) { var v = vis(), i = cur(); if (e.key === 'ArrowDown') { e.preventDefault(); sel(Math.min(v.length - 1, i + 1)); } else if (e.key === 'ArrowUp') { e.preventDefault(); sel(Math.max(0, i - 1)); } else if (e.key === 'Enter') { e.preventDefault(); if (v[i]) run(v[i]); } });
      items.forEach(function (li) { li.addEventListener('click', function () { run(li); }); li.addEventListener('mousemove', function () { sel(vis().indexOf(li)); }); });
      dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    })();
  </script>
</body>
</html>
